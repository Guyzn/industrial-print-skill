    {
      "type": "section",
      "id": "why",
      "label": "Our Strengths",
      "title": "Why Exsteel",
      "sub": "Four Things We Do Differently",
      "blocks": [
        {
          "type": "adv",
          "items": [
            {
              "no": "01",
              "t": "Heavy Manufacturing Capability",
              "p": "A 66,000 m² forging base equipped with a 5,000-ton hydraulic forging press, forging manipulators, 50-ton LF refining furnace, 50-ton VD vacuum degassing furnace and in-house ESR remelting furnaces. A dedicated 110 kV substation guarantees stable power for heavy forging operations."
            },
            {
              "no": "02",
              "t": "Complete In-House Process Route",
              "p": "Melting, LF/VD refining, ESR remelting, forging, heat treatment — spheroidizing annealing, pre-hardening, quenching, tempering, normalizing — deep cryogenic treatment and machining. One purchase order covers the entire chain."
            },
            {
              "no": "03",
              "t": "Testing and ISO 9001:2015",
              "p": "Complete in-house laboratory: SPECTRO direct-reading spectrometer, O/N/H analyzer, ultrasonic flaw detection, universal tensile testing, Rockwell hardness and metallographic analysis. Every heat is traceable from melt to dispatch, with EN 10204 3.1 certificates."
            },
            {
              "no": "04",
              "t": "Customization to Your Drawings",
              "p": "Forged bars, flats, plates, blocks and modules supplied black, peeled, milled or six-face machined to ±0.05 mm, cut to length, with pre-hardening to 28–34 HRC when the part needs to go straight into the machine."
            }
          ]
        },
        {
          "type": "photo",
          "fill": true,
          "src": "images/ph-hero.svg",
          "cap": "ESR remelting shop"
        }
      ]
    },
