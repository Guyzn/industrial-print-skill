                { "v": "580", "label": { "zh": "服役温度上限 ℃", "en": "Max service temp. ℃" } },
                { "v": "14.7", "label": { "zh": "热导率 W/(m·K)", "en": "Thermal cond. W/(m·K)" } }
              ]
            }
          ]
        }
      ]
    },
