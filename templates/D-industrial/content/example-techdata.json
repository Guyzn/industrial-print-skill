              "steps": [
                {
                  "title": { "zh": "预热", "en": "Preheat" },
                  "desc": { "zh": "650–700 ℃ 分段保温，减少热应力与开裂风险。", "en": "Step soak at 650–700 ℃ to limit thermal stress and crack risk." }
                },
                {
                  "title": { "zh": "奥氏体化", "en": "Austenitising" },
                  "desc": { "zh": "1000–1030 ℃，保温时间按有效厚度计算。", "en": "1000–1030 ℃, soak time based on effective section." }
                },
                {
                  "title": { "zh": "淬火", "en": "Quench" },
                  "desc": { "zh": "气淬或油淬，模具复杂时优先气淬控制变形。", "en": "Gas or oil quench; gas preferred for complex tools to control distortion." }
                },
                {
                  "title": { "zh": "回火（三次）", "en": "Temper (×3)" },
                  "desc": { "zh": "540–580 ℃ 回火三次，每次冷却至室温后再进行下一次。", "en": "Temper three times at 540–580 ℃, cooling to room temperature between cycles." }
                },
                {
                  "title": { "zh": "表面强化（可选）", "en": "Surface hardening (optional)" },
                  "desc": { "zh": "氮化或 PVD 涂层，基体硬度先行到位。", "en": "Nitriding or PVD coating after substrate hardness is achieved." }
                }
              ]
            }
          ]
        }
