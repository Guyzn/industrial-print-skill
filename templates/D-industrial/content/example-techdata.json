  "sections": [
    {
      "id": "t1",
      "no": "01",
      "title": { "zh": "材料概述与关键指标", "en": "Overview & Key Figures" },
      "title_en": "Overview",
      "lede": {
        "zh": "H13 是应用最广的热作模具钢之一，韧性与抗热疲劳平衡，适合压铸、热锻与挤压模具。",
        "en": "H13 is among the most widely used hot-work tool steels, balancing toughness and thermal-fatigue resistance for die-casting, hot forging and extrusion."
      },
      "spreads": [
        {
          "id": "sp-td-text",
          "layout": "D04",
          "side": "both",
          "blocks": [
            {
              "type": "text",
              "cols": 2,
              "title": { "zh": "材料定位", "en": "Material Positioning" },
              "paras": [
                {
                  "zh": "H13 属中碳中合金热作模具钢，含 Cr 约 5%、Mo 约 1.3%、V 约 0.9%。钒形成细碳化物抑制晶粒长大，钼抑制回火脆性，铬提供抗氧化与淬透性。",
                  "en": "H13 is a medium-carbon, medium-alloy hot-work steel with ~5% Cr, ~1.3% Mo and ~0.9% V. Vanadium forms fine carbides restraining grain growth; molybdenum suppresses temper embrittlement; chromium provides oxidation resistance and hardenability."
                },
                {
                  "zh": "典型失效模式为热疲劳龟裂与塌陷。延长寿命的核心不是提硬度，而是把硬度控制在工况匹配区间，并保证组织均匀、无带状碳化物偏析。",
                  "en": "Typical failure modes are thermal-fatigue cracking and collapse. Life extension depends less on raising hardness than on matching hardness to the duty and ensuring a uniform structure free of banded carbide segregation."
                },
                {
                  "zh": "本表所列数据为典型值，不构成验收依据。验收按订单约定的标准与抽样方案执行。",
                  "en": "Values herein are typical and do not constitute acceptance criteria. Acceptance follows the standard and sampling plan agreed in the order."
                }
              ],
              "pull": {
                "q": { "zh": "模具钢的竞争不在硬度表上，在寿命上。", "en": "Competition in tool steel is not on the hardness chart — it is on tool life." },
                "who": { "zh": "技术部口径", "en": "Engineering note" }
              }
            }
          ]
        },
        {
          "id": "sp-td-stats",
          "layout": "D11",
          "side": "both",
          "blocks": [
            {
