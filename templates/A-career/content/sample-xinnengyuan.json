  <script>
    (function () {
      /* ---------- 屏幕等比缩放（无横向滚动） ---------- */
      var stage = document.querySelector('.stage');
      var spread = document.querySelector('.spread');
      function fit() {
        if (!stage || !spread) return;
        var w = spread.getBoundingClientRect().width; /* 未缩放时的 px 宽 */
        var vw = window.innerWidth - 48;
        var s = Math.min(vw / w, 1);
        stage.style.zoom = s;
      }
      window.addEventListener('resize', fit);

      /* ---------- 目录锚点跳转（不用 scrollIntoView） ---------- */
      function goTo(sel) {
        var el = document.querySelector(sel);
        if (!el) return;
        var top = el.getBoundingClientRect().top + window.scrollY - 72;
        window.scrollTo({ top: top, behavior: 'smooth' });
      }
      var nav = document.querySelector('.toc-nav');
      if (nav) {
        nav.style.display = 'block';
        nav.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', function (e) {
            e.preventDefault();
            goTo(a.getAttribute('href'));
          });
        });
      }
      var toolbar = document.querySelector('.toolbar');
      if (toolbar) {
        toolbar.querySelector('[data-od-id="toolbar-toc"]').addEventListener('click', function () { goTo('#sp-toc'); });
        toolbar.querySelector('[data-od-id="toolbar-print"]').addEventListener('click', function () { window.print(); });
        var bleedBtn = toolbar.querySelector('[data-od-id="toolbar-bleed"]');
        bleedBtn.addEventListener('click', function () {
          document.body.classList.toggle('no-bleed');
          bleedBtn.textContent = document.body.classList.contains('no-bleed') ? '无出血 420×285' : '出血 3mm';
          bleedBtn.classList.toggle('on', !document.body.classList.contains('no-bleed'));
        });
      }

      fit();
    })();
  </script>
