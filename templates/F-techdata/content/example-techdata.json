    {
      "type": "grade",
      "id": "p-overview",
      "valign": "top",
      "label": { "zh": "材料概述", "en": "Overview" },
      "banner": {
        "code": "H13 / 1.2344",
        "family": { "zh": "中碳中合金热作模具钢", "en": "Medium-alloy hot-work tool steel" },
        "standards": "AISI H13 · DIN 1.2344 · GB 4Cr5MoSiV1"
      },
      "blocks": [
        { "type": "text", "head": { "zh": "材料定位", "en": "Material Positioning" }, "paras": [
          { "zh": "H13 属中碳中合金热作模具钢，含 Cr 约 5%、Mo 约 1.3%、V 约 0.9%。钒形成细碳化物抑制晶粒长大，钼抑制回火脆性，铬提供抗氧化与淬透性。", "en": "H13 is a medium-carbon, medium-alloy hot-work steel with ~5% Cr, ~1.3% Mo and ~0.9% V. Vanadium forms fine carbides restraining grain growth; molybdenum suppresses temper embrittlement; chromium provides oxidation resistance and hardenability." },
          { "zh": "典型失效模式为热疲劳龟裂与塌陷。延长寿命的核心不是提硬度，而是把硬度控制在工况匹配区间，并保证组织均匀、无带状碳化物偏析。", "en": "Typical failure modes are thermal-fatigue cracking and collapse. Life extension depends less on raising hardness than on matching hardness to the duty and ensuring a uniform structure free of banded carbide segregation." }
        ]},
        { "type": "kv", "head": { "zh": "关键指标一览", "en": "Key Figures at a Glance" }, "items": [
          { "n": "0.38", "d": { "zh": "碳含量典型值 wt%", "en": "Carbon, typical wt%" } },
          { "n": "1290", "d": { "zh": "抗拉强度 MPa（调质）", "en": "UTS MPa (Q&T)" } },
          { "n": "580", "d": { "zh": "服役温度上限 ℃", "en": "Max service temp. ℃" } },
          { "n": "14.7", "d": { "zh": "热导率 W/(m·K)", "en": "Thermal cond. W/(m·K)" } }
        ]},
        { "type": "note", "title": { "zh": "验收口径", "en": "Acceptance" }, "text": { "zh": "本表所列数据为典型值，不构成验收依据。验收按订单约定的标准与抽样方案执行。", "en": "Values herein are typical and do not constitute acceptance criteria. Acceptance follows the standard and sampling plan agreed in the order." } }
      ]
    },
